{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "racks.schema.json",
  "title": "Racks",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "wledInstance", "rowLayout"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "wledInstance": { "type": "string" },
      "rowLayout": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
